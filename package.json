{
  "name": "paseo-multi-project",
  "version": "0.1.7",
  "private": true,
  "description": "Coordinate coding tasks across existing Paseo projects.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChrisLauinger77/paseo-multi-project.git"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "assets/",
    "NOTICE",
    "!**/*.test.ts"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint client server shared index.client.tsx index.server.ts tests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:unit": "vitest run client server --bail=1",
    "test:compat": "vitest run tests/compat.test.ts --bail=1",
    "test:browser": "playwright test",
    "test:real": "vitest run --config vitest.real.config.ts --bail=1"
  },
  "devDependencies": {
    "@getpaseo/client": "0.16.2",
    "@getpaseo/plugin": "0.16.2",
    "@getpaseo/protocol": "0.16.2",
    "@getpaseo/server": "0.16.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.65.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "22.20.5",
    "@types/react": "~19.2.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "pino": "10.4.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "^7.0.0",
    "vitest": "5.1.1",
    "zod": "^4.4.3"
  }
}
