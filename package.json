{
  "name": "paseo-multi-project",
  "version": "0.1.1",
  "private": true,
  "description": "Coordinate coding tasks across existing Paseo projects.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChrisLauinger77/paseo-multi-project.git"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "assets/",
    "NOTICE",
    "!**/*.test.ts"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint client server shared index.client.tsx index.server.ts tests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:unit": "vitest run client/form.test.ts server/projects.test.ts --bail=1",
    "test:compat": "vitest run tests/compat.test.ts --bail=1",
    "test:browser": "playwright test",
    "test:real": "vitest run --config vitest.real.config.ts --bail=1"
  },
  "devDependencies": {
    "@getpaseo/client": "0.15.4",
    "@getpaseo/plugin": "0.15.4",
    "@getpaseo/protocol": "0.15.4",
    "@getpaseo/server": "0.15.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/test": "1.58.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "22.19.0",
    "@types/react": "~19.2.0",
    "oxfmt": "0.40.0",
    "oxlint": "1.58.0",
    "pino": "9.14.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "4.1.7",
    "zod": "^4.4.3"
  }
}
